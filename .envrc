# direnv: OPTIONAL since the plugin mounts the venv itself (SLIPBOX_SEMANTIC_VENV)
# and dlopens libstdc++ when the linker cannot. Kept for shells that want the
# stack on PATH for bare `python -m slipbox …` work in this directory.
#
# direnv: make the slipbox semantic layer (bge-m3 + reranker) reachable to
# hermes' in-process Python 3.12 interpreter, so a bare `hermes -p slipbox …`
# works from this directory (mirrors ./hermes-slipbox for other contexts).
#
# Why these two vars — see the hermes-slipbox wrapper header: the plugin loads
# in-process inside hermes' own python, which lacks torch/FlagEmbedding, and on
# NixOS foreign torch needs libstdc++ via LD_LIBRARY_PATH. path_add prepends and
# exports, composing with any values already in the environment.

# cp312 venv holding torch / FlagEmbedding (override with SLIPBOX_SEMANTIC_VENV).
: "${SLIPBOX_SEMANTIC_VENV:=$PWD/.venv-hermes312}"
_slipbox_site="$SLIPBOX_SEMANTIC_VENV/lib/python3.12/site-packages"

if [[ -d "$_slipbox_site" ]]; then
  path_add PYTHONPATH "$_slipbox_site"
  path_add LD_LIBRARY_PATH /run/current-system/sw/share/nix-ld/lib
else
  log_status "slipbox: $_slipbox_site missing — semantic layer stays on python-fallback"
fi
unset _slipbox_site

tmuxify
